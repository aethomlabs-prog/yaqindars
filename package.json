{
  "name": "yaqindars",
  "private": true,
  "description": "YaqinDars — uyga yaqin o'quv markazlari: mobil ilova (Expo), veb sayt, Firebase Functions",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:rules": "pnpm --filter functions test:rules",
    "emulators": "node scripts/fb.cjs emulators:start --project demo-yaqindars --import ./emulator-data --export-on-exit ./emulator-data"
  },
  "devDependencies": {
    "firebase-tools": "13.29.1"
  }
}
