# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)  va qiymatlarni to‘ldiring.
# .env faylini hech qachon GitHub'ga yuklamang!

# @BotFather dan olingan token
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mini App joylashgan HTTPS manzil (GitHub Pages / Vercel / Netlify)
WEBAPP_URL=https://username.github.io/yaqindars/

# Admin(lar) Telegram ID si, vergul bilan. ID ni botdagi /id buyrug‘i yoki @userinfobot orqali bilish mumkin
ADMIN_IDS=123456789

# Firebase service account JSON fayl yo‘li
FIREBASE_CREDENTIALS=serviceAccount.json
