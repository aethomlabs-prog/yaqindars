rules_version = '2';
// YaqinDars — Firestore xavfsizlik qoidalari (mobil ilova modeli: request.auth.uid).
// • Ota-onalar — ko'rinmas Firebase Anonymous Auth (uid).
// • Markazlar va admin — Telegram orqali kirish → custom token, uid = "tg_<tgId>", claim'lar: tg, admin.
// • Functions (Admin SDK) qoidalarni chetlab o'tadi: arizalar, limitlar, bildirishnomalar, to'lov holati.
// LEGACY — eski Telegram Mini App (webapp/) uchun vaqtinchalik yo'llar; 8-bosqichda o'chiriladi.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    // Telegram ID claim (yangi custom token va LEGACY Mini App'da bir xil)
    function tg() { return signedIn() && request.auth.token.get('tg', null) is int ? request.auth.token.tg : null; }
    function isTg(id) { return tg() != null && tg() == id; }

    // Markaz egasi: ownerUids ro'yxatida (rahbar + hamkorlar) yoki LEGACY ownerTgId
    function isOwnerOf(c) { return signedIn() && (me() in c.get('ownerUids', []) || isTg(c.get('ownerTgId', null))); }
    function ownsCenter(cid) { return isOwnerOf(get(/databases/$(database)/documents/centers/$(cid)).data); }
    function centerOf(cid) { return get(/databases/$(database)/documents/centers/$(cid)).data; }

    // Faqat admin / Functions o'zgartiradigan maydonlar
    function protectedCenterKeys() {
      return ['approved', 'vip', 'tariff', 'verified', 'verifiedAt', 'paidUntil', 'hidden', 'hiddenAt', 'ownerUids', 'ownerTgId',
              'ownerUsername', 'claimed', 'claimedAt', 'claimedVia', 'status', 'approvedBy', 'ratingSum', 'ratingCount', 'source',
              'createdAt', 'addedBy', 'billingReminded', 'lastReminderAt'];
    }
    function validPhone(p) { return p is string && p.matches('^\\+998[0-9]{9}$'); }
    function validCenterFields(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && validPhone(d.phone)
        && d.get('address', '') is string && d.get('address', '').size() <= 200
        && d.get('description', '') is string && d.get('description', '').size() <= 1000
        && d.get('amenities', []) is list && d.get('amenities', []).size() <= 12
        && d.get('groups', []) is list && d.get('groups', []).size() <= 10
        && d.get('teachers', []) is list && d.get('teachers', []).size() <= 12
        && d.lat is number && d.lng is number
        && d.get('kind', 'center') in ['center', 'tutor']
        && d.get('photoCount', 0) is int && d.get('photoCount', 0) >= 0 && d.get('photoCount', 0) <= 5;
    }

    // Ochiq sozlamalar
    match /meta/public {
      allow read: if true;
      allow write: if false;
    }

    // ---------------- Markazlar ----------------
    // O'qish: tasdiqlanganlar — hamma; o'zinikini — egasi; hammasini — admin.
    // «hidden» (to'lov kechikkan) — ko'rsatish bayrog'i: ilova ro'yxatdan chiqaradi, ma'lumot sir emas.
    match /centers/{id} {
      allow read: if resource.data.approved == true || isOwnerOf(resource.data) || isAdmin();

      // Ro'yxatdan o'tish (Markaz rejimi): o'zini yagona egasi qilib, tasdiqlanmagan holda
      allow create: if signedIn() && tg() != null
        && request.resource.data.ownerUids == [me()]
        && request.resource.data.approved == false
        && request.resource.data.vip == false
        && request.resource.data.get('tariff', 'oddiy') in ['oddiy', 'vip']
        && !request.resource.data.keys().hasAny(['verified', 'verifiedAt', 'paidUntil', 'hidden', 'ownerTgId', 'ratingSum', 'ratingCount'])
        && request.resource.data.createdAt == request.time
        && validCenterFields(request.resource.data);
      // Admin: tez qo'shish — egasiz markaz («Ma'lumot tasdiqlanmagan»)
      allow create: if isAdmin()
        && request.resource.data.source == 'admin'
        && request.resource.data.claimed == false
        && request.resource.data.get('ownerUids', []).size() == 0
        && request.resource.data.get('ownerTgId', null) == null
        && request.resource.data.approved == true
        && validCenterFields(request.resource.data);

      // Egasi: profil, guruhlar, o'qituvchilar, rasmlar soni — himoyalangan maydonlarsiz
      allow update: if isOwnerOf(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedCenterKeys())
        && request.resource.data.updatedAt == request.time
        && validCenterFields(request.resource.data);
      // Admin: istalgan maydon (tasdiqlash, VIP, to'lov, belgi, biriktirish)
      allow update: if isAdmin();
      allow delete: if false;

      // LEGACY: rasmlar Firestore'da (data URL). Yangi ilova — Firebase Storage (storage.rules).
      match /photos/{n} {
        allow read: if centerOf(id).approved == true || ownsCenter(id) || isAdmin();
        allow delete: if ownsCenter(id) && n in ['0', '1', '2', '3', '4'];
        allow create, update: if ownsCenter(id) && n in ['0', '1', '2', '3', '4']
          && request.resource.data.keys().hasOnly(['data', 'order'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 240000
          && request.resource.data.data[0:23] == 'data:image/jpeg;base64,'
          && request.resource.data.order == int(n);
      }
    }

    // ---------------- Foydalanuvchi profili ----------------
    // users/{uid} — faqat o'zi. LEGACY: users/{tgId} (Mini App).
    match /users/{uid} {
      function self() { return signedIn() && (me() == uid || (tg() != null && string(tg()) == uid)); }
      allow read: if self() || isAdmin();
      // role va Telegram ma'lumotlarini faqat Functions yozadi
      allow create: if self() && !request.resource.data.keys().hasAny(['role', 'tgId', 'tgUsername', 'tgName']);
      allow update: if self() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tgId', 'tgUsername', 'tgName']);
      allow delete: if self();
      match /{sub}/{docId} {
        allow read, write: if self() && sub in ['children', 'favorites', 'addresses', 'devices'];
      }
    }

    // ---------------- Arizalar ----------------
    // Yangi ilova arizani FAQAT callable submitApplication orqali yuboradi (limitlar Functions'da).
    match /applications/{id} {
      function isApplicant(d) { return signedIn() && (d.get('uid', '') == me() || isTg(d.get('tgUserId', null))); }

      // LEGACY: Mini App to'g'ridan-to'g'ri yozadi (uid maydonisiz)
      function validLegacyApplication(d) {
        return d.keys().hasOnly(['centerId', 'centerName', 'group', 'groupIndex', 'name', 'phone',
                                 'childId', 'comment', 'tgUserId', 'tgUsername', 'source', 'createdAt', 'notified', 'status'])
          && d.keys().hasAll(['centerId', 'name', 'phone', 'createdAt', 'notified', 'status'])
          && d.centerId is string && d.centerId.size() > 0 && d.centerId.size() <= 64
          && (!('centerName' in d) || (d.centerName is string && d.centerName.size() <= 100))
          && (!('group' in d) || (d.group is string && d.group.size() <= 120))
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
          && validPhone(d.phone)
          && (!('groupIndex' in d) || (d.groupIndex is int && d.groupIndex >= 0 && d.groupIndex < 20))
          && (!('childId' in d) || d.childId == null || (d.childId is string && d.childId.size() <= 64))
          && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
          && (!('tgUserId' in d) || d.tgUserId == null || isTg(d.tgUserId))
          && (!('source' in d) || d.source == null || (d.source is string && d.source.matches('^(src_[a-z0-9_]{2,30}|c_[A-Za-z0-9]{1,40})$')))
          && (!('tgUsername' in d) || d.tgUsername == null || (d.tgUsername is string && d.tgUsername.size() <= 64))
          && d.notified == false && d.status == 'new' && d.createdAt == request.time;
      }
      allow create: if validLegacyApplication(request.resource.data) && centerOf(request.resource.data.centerId).approved == true;

      allow read: if isApplicant(resource.data) || ownsCenter(resource.data.centerId) || isAdmin();
      // Markaz egasi holatni belgilaydi; ota-onaga xabarni Functions yuboradi
      allow update: if ownsCenter(resource.data.centerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'trialAt'])
        && request.resource.data.status in ['seen', 'accepted', 'rejected']
        && request.resource.data.statusBy in ['web', 'app']
        && (request.resource.data.get('trialAt', null) == null || request.resource.data.trialAt is timestamp);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------------- Chat (ota-ona ↔ markaz) ----------------
    // ID: "<uid>_<markazId>" (LEGACY: "<tgId>_<markazId>"). Xabarlarni bildirishnoma qilib Functions yuboradi.
    match /chats/{chatId} {
      function isParent(d) { return signedIn() && (d.get('userUid', '') == me() || isTg(d.get('userTgId', null))); }
      function isCenterSide(d) { return ownsCenter(d.centerId); }

      allow read: if resource == null || isParent(resource.data) || isCenterSide(resource.data) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userUid == me()
        && chatId == me() + '_' + request.resource.data.centerId
        && request.resource.data.keys().hasOnly(['type', 'centerId', 'centerName', 'userUid', 'userName',
                                                 'lastMessage', 'lastAt', 'unreadUser', 'unreadCenter'])
        && request.resource.data.type == 'center'
        && request.resource.data.centerName is string && request.resource.data.centerName.size() <= 100
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadUser == 0 && request.resource.data.unreadCenter == 0
        && centerOf(request.resource.data.centerId).approved == true;
      // LEGACY yaratish (Mini App)
      allow create: if isTg(request.resource.data.userTgId)
        && chatId == string(tg()) + '_' + request.resource.data.centerId
        && request.resource.data.keys().hasOnly(['type', 'centerId', 'centerName', 'userTgId', 'userName', 'userUsername',
                                                 'lastMessage', 'lastAt', 'unreadUser', 'unreadCenter'])
        && request.resource.data.type == 'center'
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadUser == 0 && request.resource.data.unreadCenter == 0
        && centerOf(request.resource.data.centerId).approved == true;
      // Ota-ona: yozdi (unreadCenter +1) yoki o'qidi (unreadUser = 0)
      allow update: if isParent(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'unreadCenter', 'unreadUser'])
        && request.resource.data.unreadUser in [0, resource.data.unreadUser]
        && request.resource.data.unreadCenter in [resource.data.unreadCenter, resource.data.unreadCenter + 1]
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200;
      // Markaz: javob berdi (unreadUser +1) yoki o'qidi (unreadCenter = 0)
      allow update: if isCenterSide(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'unreadCenter', 'unreadUser'])
        && request.resource.data.unreadCenter in [0, resource.data.unreadCenter]
        && request.resource.data.unreadUser in [resource.data.unreadUser, resource.data.unreadUser + 1]
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200;
      allow delete: if isParent(resource.data);

      match /messages/{msgId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function validMsg(from) {
          return request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'notified'])
            && request.resource.data.from == from
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && request.resource.data.notified == false
            && request.resource.data.createdAt == request.time;
        }
        allow read: if isParent(chat()) || isCenterSide(chat()) || isAdmin();
        allow create: if (isParent(chat()) && validMsg('user')) || (isCenterSide(chat()) && validMsg('center'));
        allow update, delete: if false;
      }
    }

    // ---------------- Ota-onalar: kuzatuv, navbat, baho, shikoyat ----------------
    match /watches/{id} {
      function owner(d) { return signedIn() && (d.get('userUid', '') == me() || isTg(d.get('userTgId', null))); }
      allow read: if owner(resource.data) || isAdmin();
      allow delete: if owner(resource.data);
      allow create: if signedIn()
        && (request.resource.data.get('userUid', '') == me() || isTg(request.resource.data.get('userTgId', null)))
        && request.resource.data.keys().hasOnly(['userUid', 'userTgId', 'subject', 'radiusKm', 'maxPrice', 'days', 'lat', 'lng', 'active', 'createdAt'])
        && (request.resource.data.subject == null || (request.resource.data.subject is string && request.resource.data.subject.size() <= 40))
        && (request.resource.data.radiusKm == null || (request.resource.data.radiusKm is number && request.resource.data.radiusKm > 0 && request.resource.data.radiusKm <= 50))
        && (request.resource.data.maxPrice == null || (request.resource.data.maxPrice is number && request.resource.data.maxPrice >= 10000 && request.resource.data.maxPrice <= 10000000))
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // «Joy bo'shasa xabar ber»
    match /waitlist/{id} {
      allow create: if signedIn()
        && (request.resource.data.get('userUid', '') == me() || isTg(request.resource.data.get('userTgId', null)))
        && request.resource.data.keys().hasOnly(['centerId', 'groupIndex', 'userUid', 'userTgId', 'createdAt', 'notified'])
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && request.resource.data.groupIndex is int && request.resource.data.groupIndex >= 0 && request.resource.data.groupIndex < 20
        && request.resource.data.notified == false
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.get('userUid', '') == me());
      allow update, delete: if false;
    }

    // Baholar — Functions yozadi (faqat qabul qilingan ariza egasi, bir marta)
    match /ratings/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('userUid', '') == me() || isTg(resource.data.get('userTgId', null))));
      allow write: if false;
    }

    // «Ma'lumot noto'g'ri» — ID = "<uid yoki tgId>_<markazId>_<sana>": kuniga bir markazga bitta
    match /reports/{id} {
      function validReport(d) {
        return d.centerId is string && d.centerId.size() > 0 && d.centerId.size() <= 64
          && d.centerName is string && d.centerName.size() <= 100
          && d.reason in ['price', 'seats', 'contact', 'closed', 'other']
          && d.comment is string && d.comment.size() <= 300
          && d.status == 'new' && d.createdAt == request.time;
      }
      allow read: if isAdmin() || (signedIn() && (resource.data.get('uid', '') == me() || isTg(resource.data.get('tgId', null))));
      allow create: if signedIn() && request.resource.data.get('uid', '') == me()
        && id.matches('^' + me() + '_' + request.resource.data.centerId + '_20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['centerId', 'centerName', 'reason', 'comment', 'uid', 'status', 'createdAt'])
        && validReport(request.resource.data);
      // LEGACY
      allow create: if isTg(request.resource.data.get('tgId', null))
        && id.matches('^' + string(tg()) + '_' + request.resource.data.centerId + '_20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['centerId', 'centerName', 'reason', 'comment', 'tgId', 'status', 'createdAt'])
        && validReport(request.resource.data);
      allow update, delete: if false;
    }

    // «Bu mening markazim» (egallash) — Telegram orqali kirgan foydalanuvchi (tg claim)
    match /claimRequests/{id} {
      function validClaim(d) {
        return d.keys().hasOnly(['centerId', 'centerName', 'tgId', 'name', 'username', 'status', 'createdAt'])
          && isTg(d.tgId)
          && id == string(tg()) + '_' + d.centerId
          && d.centerId is string && d.centerId.size() > 0 && d.centerId.size() <= 64
          && d.centerName is string && d.centerName.size() <= 100
          && d.name is string && d.name.size() <= 60
          && (d.username == null || (d.username is string && d.username.size() <= 64))
          && d.status == 'pending'
          && d.createdAt == request.time
          && centerOf(d.centerId).get('claimed', true) == false;
      }
      allow read: if resource == null || isTg(resource.data.tgId) || isAdmin();
      allow create: if validClaim(request.resource.data);
      allow update: if resource.data.status == 'rejected' && validClaim(request.resource.data);
      allow delete: if false;
    }

    // ---------------- Telegram orqali kirish ----------------
    // Token hujjatini faqat Functions yozadi; ilova (o'sha anonim uid) holatini real vaqtda kuzatadi.
    match /tgLogins/{token} {
      allow read: if signedIn() && resource.data.anonUid == me();
      allow write: if false;
    }
    match /tgLoginFails/{uid} { allow read, write: if false; }
    // Ariza limitlari va boshqa hisoblagichlar — faqat Functions
    match /counters/{id} { allow read, write: if false; }

    // ---------------- Statistika (kunlik hisoblagichlar, +1 dan boshqa yozuv yo'q) ----------------
    match /centerStats/{id} {
      allow read: if isAdmin() || ownsCenter(resource.data.centerId);
      allow create: if id == request.resource.data.centerId + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['centerId', 'date', 'views', 'calls', 'routes'])
        && request.resource.data.keys().size() == 3
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.get('views', 1) == 1
        && request.resource.data.get('calls', 1) == 1
        && request.resource.data.get('routes', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'calls', 'routes'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.get('views', 0) - resource.data.get('views', 0) in [0, 1]
        && request.resource.data.get('calls', 0) - resource.data.get('calls', 0) in [0, 1]
        && request.resource.data.get('routes', 0) - resource.data.get('routes', 0) in [0, 1];
      allow delete: if false;
    }
    match /dailyStats/{date} {
      allow read: if isAdmin();
      allow create: if date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == date
        && request.resource.data.keys().hasOnly(['date', 'open', 'view'])
        && request.resource.data.keys().size() == 2
        && request.resource.data.get('open', 1) == 1
        && request.resource.data.get('view', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'view'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.get('open', 0) - resource.data.get('open', 0) in [0, 1]
        && request.resource.data.get('view', 0) - resource.data.get('view', 0) in [0, 1];
      allow delete: if false;
    }
    match /sourceStats/{src} {
      allow read: if isAdmin();
      allow create: if src.matches('^(src_[a-z0-9_]{2,30}|c_[A-Za-z0-9]{1,40})$')
        && request.resource.data.keys().hasOnly(['source', 'users'])
        && request.resource.data.source == src
        && request.resource.data.users == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
        && request.resource.data.users == resource.data.get('users', 0) + 1;
      allow delete: if false;
    }

    // Texnik xatolar: ilova yozadi (o'lchami cheklangan), faqat admin o'qiydi
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['source', 'level', 'message', 'stack', 'screen', 'device', 'url', 'tgUserId', 'uid', 'createdAt'])
        && request.resource.data.source in ['web', 'app'] && request.resource.data.level == 'error'
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 100
        && request.resource.data.device is string && request.resource.data.device.size() <= 300
        && request.resource.data.get('url', '') is string && request.resource.data.get('url', '').size() <= 200
        && (request.resource.data.get('tgUserId', null) == null || isTg(request.resource.data.tgUserId))
        && (request.resource.data.get('uid', null) == null || (signedIn() && request.resource.data.uid == me()))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------- LEGACY (Mini App + Python bot) — 8-bosqichda o'chiriladi ----------------
    match /tgLinks/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['initData', 'status', 'createdAt'])
        && request.resource.data.initData is string && request.resource.data.initData.size() <= 4096
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }
    match /aiRequests/{id} {
      allow read: if isTg(resource.data.userTgId) || isAdmin();
      allow create: if isTg(request.resource.data.userTgId)
        && request.resource.data.keys().hasOnly(['userTgId', 'query', 'history', 'pos', 'status', 'createdAt'])
        && request.resource.data.query is string && request.resource.data.query.size() > 0 && request.resource.data.query.size() <= 500
        && request.resource.data.history is list && request.resource.data.history.size() <= 8
        && request.resource.data.pos is map
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /deleteRequests/{tgId} {
      allow read: if tg() != null && string(tg()) == tgId;
      allow create, update: if tg() != null && string(tg()) == tgId
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }
    match /botRequests/{id} {
      allow create: if isTg(request.resource.data.tgId)
        && request.resource.data.keys().hasOnly(['type', 'centerId', 'tgId', 'status', 'createdAt'])
        && request.resource.data.type == 'qr'
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && ownsCenter(request.resource.data.centerId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow create: if isAdmin() && isTg(request.resource.data.tgId)
        && request.resource.data.keys().hasOnly(['type', 'tgId', 'status', 'createdAt'])
        && request.resource.data.type == 'remindStale'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Faqat server: kodlar, kuzatuv hisobi, bot holati
    match /claimCodes/{code} { allow read, write: if false; }
    match /watchDaily/{id} { allow read, write: if false; }
    match /system/{doc} { allow read, write: if false; }
  }
}
