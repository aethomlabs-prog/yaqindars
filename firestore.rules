rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Telegram orqali tasdiqlangan foydalanuvchi: Mini App anonim kiradi, bot initData imzosini
    // tekshirib, unga "tg" (Telegram ID) claim'ini qo'yadi. Shu claim — yagona ishonchli ID.
    function tg() {
      return request.auth != null && ('tg' in request.auth.token) && request.auth.token.tg is int ? request.auth.token.tg : null;
    }
    function isTg(id) {
      return tg() != null && tg() == id;
    }
    // Admin (bot ADMIN_IDS dagilarga "admin" claim'ini qo'yadi) — admin dashboard (?mode=admin)
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Ochiq sozlamalar (bot username) — faqat bot yozadi.
    match /meta/public {
      allow read: if true;
      allow write: if false;
    }

    // Markazlar: hamma faqat TASDIQLANGANLARINI o'qiy oladi.
    // Mini App so'rovi where("approved", "==", true) bilan bo'lishi shart, aks holda qoida rad etadi.
    // Yozish faqat bot orqali (Admin SDK qoidalarni chetlab o'tadi).
    // Markaz egasi (kabinet) o'z markazini tasdiqlanmagan bo'lsa ham ko'radi va faqat guruhlarini
    // (bo'sh joy, narx) o'zgartira oladi. Qolgan maydonlar (approved, vip, tariff...) — faqat bot/admin.
    function ownsCenter(cid) {
      return isTg(get(/databases/$(database)/documents/centers/$(cid)).data.ownerTgId);
    }
    match /centers/{id} {
      allow read: if resource.data.approved == true || isTg(resource.data.ownerTgId) || isAdmin();
      // Admin: tasdiqlash / rad etish / VIP. Egaga xabarni bot yuboradi (approvedBy: 'web').
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'vip', 'approvedBy', 'status', 'updatedAt'])
        && request.resource.data.approvedBy == 'web'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.approved is bool && request.resource.data.vip is bool;
      // Admin: to'lov qabul qilindi — muddatni uzaytirish (yashirilgan bo'lsa xaritaga qaytadi)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidUntil', 'updatedAt', 'hidden'])
        && request.resource.data.paidUntil is timestamp
        && request.resource.data.get('hidden', false) == false;
      // Admin: tez qo'shish — egasiz markaz («Ma'lumot tasdiqlanmagan»)
      allow create: if isAdmin()
        && request.resource.data.source == 'admin'
        && request.resource.data.claimed == false
        && request.resource.data.ownerTgId == null
        && request.resource.data.approved == true
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.phone is string && request.resource.data.phone.matches('^\\+998[0-9]{9}$')
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 10;
      allow update: if isTg(resource.data.ownerTgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups', 'updatedAt'])
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 10
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // «Bu mening markazim»: ID = "<tgId>_<markazId>" (bitta markazga bitta so'rov). Admin botda tasdiqlaydi.
    match /claimRequests/{id} {
      function validClaim(d) {
        return d.keys().hasOnly(['centerId', 'centerName', 'tgId', 'name', 'username', 'status', 'createdAt'])
          && isTg(d.tgId)
          && id == string(tg()) + '_' + d.centerId
          && d.centerId is string && d.centerId.size() > 0 && d.centerId.size() <= 64
          && d.centerName is string && d.centerName.size() <= 100
          && d.name is string && d.name.size() <= 60
          && (d.username == null || (d.username is string && d.username.size() <= 64))
          && d.status == 'pending'
          && d.createdAt == request.time
          && get(/databases/$(database)/documents/centers/$(d.centerId)).data.get('claimed', true) == false;
      }
      allow read: if resource == null || isTg(resource.data.tgId) || isAdmin();
      allow create: if validClaim(request.resource.data);
      // Rad etilgan so'rovni qayta yuborish mumkin
      allow update: if resource.data.status == 'rejected' && validClaim(request.resource.data);
      allow delete: if false;
    }

    // Admin bergan bir martalik kodlar (/claimcode) — faqat bot
    match /claimCodes/{code} {
      allow read, write: if false;
    }

    // Ilovadan botga topshiriq: markaz egasi o'z markazining QR posterini so'raydi
    match /botRequests/{id} {
      allow create: if isTg(request.resource.data.tgId)
        && request.resource.data.keys().hasOnly(['type', 'centerId', 'tgId', 'status', 'createdAt'])
        && request.resource.data.type == 'qr'
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && ownsCenter(request.resource.data.centerId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Markaz statistikasi: kunlik hisoblagich, ID = "<markazId>_<YYYY-MM-DD>".
    // Ilova faqat bitta maydonni +1 qila oladi (ko'rish, qo'ng'iroq, yo'l); arizalarni bot sanaydi.
    // O'qish — faqat markaz egasi va admin.
    match /centerStats/{id} {
      allow read: if isAdmin() || ownsCenter(resource.data.centerId);
      allow create: if id == request.resource.data.centerId + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['centerId', 'date', 'views', 'calls', 'routes'])
        && request.resource.data.keys().size() == 3
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.get('views', 1) == 1
        && request.resource.data.get('calls', 1) == 1
        && request.resource.data.get('routes', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'calls', 'routes'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.get('views', 0) - resource.data.get('views', 0) in [0, 1]
        && request.resource.data.get('calls', 0) - resource.data.get('calls', 0) in [0, 1]
        && request.resource.data.get('routes', 0) - resource.data.get('routes', 0) in [0, 1];
      allow delete: if false;
    }

    // Telegram tasdiqlash so'rovi: anonim foydalanuvchi faqat o'z hujjatini "pending" holatida yozadi.
    match /tgLinks/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['initData', 'status', 'createdAt'])
        && request.resource.data.initData is string && request.resource.data.initData.size() <= 4096
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    // Texnik xato yozuvlari: ilova yozadi (o'lchami cheklangan), faqat admin o'qiydi.
    // "admin" claim'ini bot ADMIN_IDS dagilarga Telegram tasdiqlashda qo'yadi.
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['source', 'level', 'message', 'stack', 'screen', 'device', 'url', 'tgUserId', 'createdAt'])
        && request.resource.data.source == 'web' && request.resource.data.level == 'error'
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 100
        && request.resource.data.device is string && request.resource.data.device.size() <= 300
        && request.resource.data.url is string && request.resource.data.url.size() <= 200
        && (request.resource.data.tgUserId == null || isTg(request.resource.data.tgUserId))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // AI yordamchi: foydalanuvchi savol yozadi, javobni bot (Groq orqali) yozadi.
    match /aiRequests/{id} {
      allow read: if isTg(resource.data.userTgId) || isAdmin();
      allow create: if isTg(request.resource.data.userTgId)
        && request.resource.data.keys().hasOnly(['userTgId', 'query', 'history', 'pos', 'status', 'createdAt'])
        && request.resource.data.query is string && request.resource.data.query.size() > 0 && request.resource.data.query.size() <= 500
        && request.resource.data.history is list && request.resource.data.history.size() <= 8
        && request.resource.data.pos is map
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // «Ma'lumotlarimni o'chirish»: foydalanuvchi so'rov qoldiradi, o'chirishni bot (Admin SDK) bajaradi.
    match /deleteRequests/{tgId} {
      allow read: if tg() != null && string(tg()) == tgId;
      allow create, update: if tg() != null && string(tg()) == tgId
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    // Profil: faqat egasi (hujjat ID = Telegram ID).
    match /users/{tgId} {
      allow read, write: if tg() != null && string(tg()) == tgId;
      match /{sub}/{docId} {
        allow read, write: if tg() != null && string(tg()) == tgId && sub in ['children', 'favorites'];
      }
    }

    // Arizalar: Mini App yangi ariza yaratadi; tasdiqlangan foydalanuvchi faqat O'Z arizalarini o'qiydi.
    // Holatni (seen/accepted/rejected) faqat bot o'zgartiradi.
    match /applications/{id} {
      function validApplication(d) {
        return d.keys().hasOnly(['centerId', 'centerName', 'group', 'groupIndex', 'name', 'phone',
                                 'childId', 'comment', 'tgUserId', 'tgUsername', 'source', 'createdAt', 'notified', 'status'])
          && d.keys().hasAll(['centerId', 'name', 'phone', 'createdAt', 'notified', 'status'])
          && d.centerId is string && d.centerId.size() > 0 && d.centerId.size() <= 64
          && (!('centerName' in d) || (d.centerName is string && d.centerName.size() <= 100))
          && (!('group' in d) || (d.group is string && d.group.size() <= 120))
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
          && d.phone is string && d.phone.matches('^\\+998[0-9]{9}$')
          && (!('groupIndex' in d) || (d.groupIndex is int && d.groupIndex >= 0 && d.groupIndex < 20))
          && (!('childId' in d) || d.childId == null || (d.childId is string && d.childId.size() <= 64))
          && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
          // tgUserId — faqat o'ziniki (boshqa odam nomidan ariza yuborib bo'lmaydi)
          && (!('tgUserId' in d) || d.tgUserId == null || isTg(d.tgUserId))
          // qayerdan kelgan: src_<kanal> yoki c_<markazId> (kampaniya / markaz QR'i)
          && (!('source' in d) || d.source == null || (d.source is string && d.source.matches('^(src_[a-z0-9_]{2,30}|c_[A-Za-z0-9]{1,40})$')))
          && (!('tgUsername' in d) || d.tgUsername == null
              || (d.tgUsername is string && d.tgUsername.size() <= 64))
          && d.notified == false
          && d.status == 'new'
          && d.createdAt == request.time;
      }

      allow create: if validApplication(request.resource.data)
        // ariza faqat mavjud va tasdiqlangan markazga
        && get(/databases/$(database)/documents/centers/$(request.resource.data.centerId)).data.approved == true;
      allow read: if isTg(resource.data.tgUserId) || ownsCenter(resource.data.centerId) || isAdmin();
      // Kabinet: markaz egasi holatni belgilaydi; bot "statusBy: web" ni ko'rib ota-onaga xabar yuboradi
      allow update: if ownsCenter(resource.data.centerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'trialAt'])
        && request.resource.data.status in ['seen', 'accepted', 'rejected']
        && request.resource.data.statusBy == 'web'
        && (request.resource.data.get('trialAt', null) == null || request.resource.data.trialAt is timestamp);
      allow delete: if false;
    }

    // «Joy bo'shasa xabar ber»
    match /waitlist/{id} {
      allow create: if isTg(request.resource.data.userTgId)
        && request.resource.data.keys().hasOnly(['centerId', 'groupIndex', 'userTgId', 'createdAt', 'notified'])
        && request.resource.data.centerId is string && request.resource.data.centerId.size() <= 64
        && request.resource.data.groupIndex is int && request.resource.data.groupIndex >= 0 && request.resource.data.groupIndex < 20
        && request.resource.data.notified == false
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Markaz bilan chat. Hujjat ID: "<tgId>_<centerId>". Markaz javoblarini bot yozadi.
    match /chats/{chatId} {
      allow read: if resource == null || isTg(resource.data.userTgId) || isAdmin();
      allow create: if isTg(request.resource.data.userTgId)
        && chatId == string(tg()) + '_' + request.resource.data.centerId
        && request.resource.data.keys().hasOnly(['type', 'centerId', 'centerName', 'userTgId', 'userName', 'userUsername',
                                                 'lastMessage', 'lastAt', 'unreadUser', 'unreadCenter'])
        && request.resource.data.type == 'center'
        && request.resource.data.centerName is string && request.resource.data.centerName.size() <= 100
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadUser == 0 && request.resource.data.unreadCenter == 0
        && get(/databases/$(database)/documents/centers/$(request.resource.data.centerId)).data.approved == true;
      // Foydalanuvchi: xabar yuborganda (lastMessage, lastAt, unreadCenter+1) yoki o'qiganda (unreadUser=0)
      allow update: if isTg(resource.data.userTgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'unreadCenter', 'unreadUser'])
        && request.resource.data.unreadUser in [0, resource.data.unreadUser]
        && request.resource.data.unreadCenter in [resource.data.unreadCenter, resource.data.unreadCenter + 1]
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200;
      allow delete: if isTg(resource.data.userTgId);

      match /messages/{msgId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isTg(chat().userTgId);
        allow create: if isTg(chat().userTgId)
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'notified'])
          && request.resource.data.from == 'user'
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.notified == false
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Bot ichki holati (yagona nusxa qulfi, rejalashtiruvchi) — faqat bot (Admin SDK) ishlatadi
    match /system/{doc} {
      allow read, write: if false;
    }
  }
}
