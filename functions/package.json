{
  "name": "functions",
  "private": true,
  "description": "YaqinDars Cloud Functions: Telegram orqali kirish (webhook), arizalar, bildirishnomalar, jadval ishlari",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --external:firebase-functions --external:firebase-admin",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/fb.cjs emulators:exec --project demo-yaqindars --only firestore,auth,storage \"jest --runInBand\"",
    "test:rules": "node ../scripts/fb.cjs emulators:exec --project demo-yaqindars --only firestore,storage \"jest --runInBand test/rules\"",
    "serve": "pnpm build && node ../scripts/fb.cjs emulators:start --project demo-yaqindars"
  },
  "dependencies": {
    "firebase-admin": "12.7.0",
    "firebase-functions": "6.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@types/jest": "29.5.14",
    "@yaqindars/shared": "workspace:*",
    "esbuild": "0.24.0",
    "firebase": "10.14.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleNameMapper": { "^@yaqindars/shared$": "<rootDir>/../packages/shared/src" }
  }
}
